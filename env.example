# Copy this file to .env on your own machine and fill in the values.
# .env is ignored by git. Never commit real values: this repository is public.

# Safe to use in the app and web dashboard (it is limited by Row Level Security).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# BACKEND ONLY (edge functions and scheduled jobs).
# Never put this in the Android app, the web code, or GitHub. It bypasses all
# access rules.
SUPABASE_SERVICE_ROLE_KEY=

# BACKEND ONLY. Added in a later phase, when the AI layer is built.
GROQ_API_KEY=
